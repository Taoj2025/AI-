# =========== ResumeAI 环境变量配置 ===========
# 复制此文件为 .env 并填写真实值
# NEVER commit .env to git

# ------- 服务器端口 -------
PORT=3000
RESUME_SERVICE_PORT=3001
EXPORT_SERVICE_PORT=3002
AI_DISPATCH_PORT=3003
USER_SERVICE_PORT=3004
TEMPLATE_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007

# ------- 数据库 -------
DATABASE_URL=postgresql://resumeai:password@localhost:5432/resumeai_db
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=resumeai
MINIO_SECRET_KEY=resumeai123
MINIO_BUCKET=resumeai-files

# ------- ClickHouse（analytics-service）-------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=resumeai_analytics
ANALYTICS_DB_BACKEND=clickhouse   # 或 memory（测试用）

# ------- JWT -------
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# ------- AI 模型 API Keys -------
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini)
GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-1.5-pro

# 百度文心一言
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_DEFAULT_MODEL=ernie-4.0-turbo

# 阿里通义千问
ALI_API_KEY=
ALI_DEFAULT_MODEL=qwen-max

# 腾讯混元
TENCENT_API_KEY=
TENCENT_DEFAULT_MODEL=hunyuan-pro

# 智谱 GLM
ZHIPU_API_KEY=
ZHIPU_DEFAULT_MODEL=glm-4-plus

# Moonshot（月之暗面）
MOONSHOT_API_KEY=
MOONSHOT_DEFAULT_MODEL=moonshot-v1-128k

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ------- Stripe 支付（真实接入）-------
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_BASIC_PRICE_ID=price_1234567890abcdef
STRIPE_PRO_PRICE_ID=price_abcdef1234567890
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id
PAYMENT_SUCCESS_URL=http://localhost:8080/payment/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:8080/payment/cancel

# ------- 微信支付（Mock 保留）-------
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/webhooks/payment

# ------- 支付宝（Mock 保留）-------
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8080/api/webhooks/payment

# ------- 支付通用 -------
PAYMENT_WEBHOOK_SECRET=demo_secret_key_change_in_production

# ------- 文件上传 -------
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.md

# ------- 日志 -------
LOG_LEVEL=info
