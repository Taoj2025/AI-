# =========== ResumeAI — 开发环境配置 ===========
# 无需 Docker，使用 SQLite 作为数据库后端

# ------- 服务端口 -------
API_GATEWAY_PORT=3000
RESUME_SERVICE_PORT=3001
EXPORT_SERVICE_PORT=3002
AI_DISPATCH_PORT=3003
USER_SERVICE_PORT=3004
TEMPLATE_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007

# ------- 数据库（SQLite 开发模式）--------
DATABASE_URL=file:./data/resumeai.db
PAYMENT_DB_BACKEND=sqlite
PAYMENT_DB_PATH=./data/payment.db
ANALYTICS_DB_BACKEND=sqlite
ANALYTICS_DB_PATH=./data/analytics.db

# ------- Redis（无 Docker 时可选内存模式）--------
REDIS_URL=memory://

# ------- JWT -------
JWT_SECRET=dev-jwt-secret-do-not-use-in-production
JWT_EXPIRES_IN=30d

# ------- AI Mock 模式 -------
MOCK_MODE=true
MOCK_AI=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
ALI_API_KEY=
TENCENT_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# ------- 日志 -------
LOG_LEVEL=debug

# ------- 环境 -------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
