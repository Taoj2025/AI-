#!/bin/bash
# ============================================================
# ResumeAI 生成环境配置
# 复制此文件为 .env 并填写真实值
# ============================================================
set -a

# ------- 服务器端口 -------
API_GATEWAY_PORT=3000
RESUME_SERVICE_PORT=3001
EXPORT_SERVICE_PORT=3002
AI_DISPATCH_PORT=3003
USER_SERVICE_PORT=3004
TEMPLATE_SERVICE_PORT=3005
ANALYTICS_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007

# ------- 数据库 -------
DATABASE_URL=postgresql://resumeai:password@postgres:5432/resumeai_db
REDIS_URL=redis://:redispass@redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=resumeai
MINIO_SECRET_KEY=resumeai123
MINIO_BUCKET=resumeai-files

# ------- ClickHouse -------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=resumeai_analytics
ANALYTICS_DB_BACKEND=clickhouse

# ------- JWT -------
# 生产环境请替换为随机 64 位字符串: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# ------- AI 模型 API Keys -------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

GOOGLE_API_KEY=
GOOGLE_DEFAULT_MODEL=gemini-1.5-pro

BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_DEFAULT_MODEL=ernie-4.0-turbo

ALI_API_KEY=
ALI_DEFAULT_MODEL=qwen-max

TENCENT_API_KEY=
TENCENT_DEFAULT_MODEL=hunyuan-pro

ZHIPU_API_KEY=
ZHIPU_DEFAULT_MODEL=glm-4-plus

MOONSHOT_API_KEY=
MOONSHOT_DEFAULT_MODEL=moonshot-v1-128k

DEEPSEEK_API_KEY=
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ------- MiniMax -------
MINIMAX_API_KEY=
MINIMAX_DEFAULT_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ------- Stripe 支付 -------
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SIGNING_SECRET
STRIPE_BASIC_PRICE_ID=price_1234567890abcdef
STRIPE_PRO_PRICE_ID=price_abcdef1234567890
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id
PAYMENT_SUCCESS_URL=http://localhost:8080/payment/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_CANCEL_URL=http://localhost:8080/payment/cancel

# ------- 支付通用 -------
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION

# ------- 文件上传 -------
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.md

# ------- 日志 -------
LOG_LEVEL=info

# ------- 环境 -------
NODE_ENV=production
