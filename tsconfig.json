{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Array", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@shared-types/*": ["packages/shared-types/src/*"],
      "@ui-components/*": ["packages/ui-components/src/*"],
      "@ai-client/*": ["packages/ai-client/src/*"],
      "@resume-service/*": ["services/resume-service/src/*"],
      "@export-service/*": ["services/export-service/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts", "**/*.spec.ts"]
}
